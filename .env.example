MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=alex_blog
PORT=4000
# Comma-separated browser origins allowed to call the API.
# Required when NODE_ENV=production. Server-side fetches are unaffected.
# Add a Vercel preview origin only for a deployment that needs it.
CORS_ORIGINS=http://localhost:3000,https://www.alexgarulli.org.uk,https://alexgarulli.org.uk
# Shared only with the Next.js server. At least 32 characters. Public reads work without it.
# openssl rand -base64 32
EDITOR_AUTH_SECRET=
# Comma-separated numeric GitHub user ids. Logins are ignored. Not a secret, but do not guess it.
ADMIN_GITHUB_IDS=
# Server-to-server secret for the publishing agent. At least 32 characters.
# Must differ from EDITOR_AUTH_SECRET. Send it only from the agent server, never from a browser.
# openssl rand -base64 32
AGENT_API_SECRET=
